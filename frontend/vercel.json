{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://13.125.66.53:8000/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://13.125.66.53:8000/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

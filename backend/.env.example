# DATABASE_URL="postgresql://postgres.npnclxvzpeedvyogpmqw:YOUR_SUPABASE_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# -------------------------------------------------------------
# Supabase 클라우드 정보
# -------------------------------------------------------------
SUPABASE_URL="https://npnclxvzpeedvyogpmqw.supabase.co"
SUPABASE_KEY="sb_publishable_XhB0631PgMX09QyjS2axJQ_MRgp8e0j"
SUPABASE_BUCKET="instagram-media"

# -------------------------------------------------------------
# CORS 및 공인 URL 설정
